# secrets & data — never commit these.
#
# Anchored to the repository root. Unanchored, `data/` matched any directory of
# that name at any depth — which silently kept the Android app's own `data`
# package (the database, the DAOs) out of every commit, so CI compiled a source
# tree with a hole in it while everything built on a desk.
.env
/data/
/secrets/
*.pem
*.key
*.db
*.db-shm
*.db-wal

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# editors / os
.DS_Store
.idea/
.vscode/

# android build outputs (the shipped APK in dist/ is committed deliberately)
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.keystore
*.jks
