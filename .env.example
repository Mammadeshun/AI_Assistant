# --- core ------------------------------------------------------------------
# Where this app is reachable. Used to build OAuth redirect URIs.
PUBLIC_BASE_URL=http://localhost:8000

# Encrypts bank tokens before they touch disk. REQUIRED.
#   python -m backend.app.security --new-key
ENCRYPTION_KEY=

# Signs session cookies. Changing it signs you out.
#   python -m backend.app.security --new-secret
SESSION_SECRET=

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

DATABASE_URL=sqlite:///./data/finance.db
DEFAULT_CURRENCY=GBP

# --- Revolut personal, via GoCardless Bank Account Data --------------------
# Free tier: https://bankaccountdata.gocardless.com/ -> Developers -> User secrets
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Must exactly match a redirect URI allowed on your GoCardless account.
GOCARDLESS_REDIRECT_URI=http://localhost:8000/api/connections/gocardless/callback

# --- Revolut Business API --------------------------------------------------
# https://business.revolut.com/settings/api -> add an API certificate
REVOLUT_ENVIRONMENT=sandbox
REVOLUT_CLIENT_ID=
REVOLUT_PRIVATE_KEY_PATH=./secrets/revolut-privatekey.pem
REVOLUT_REDIRECT_URI=http://localhost:8000/api/connections/revolut-business/callback

# --- sync behaviour --------------------------------------------------------
# How far back the first sync reaches (aggregators usually cap this at 730 days).
INITIAL_SYNC_DAYS=730
# Re-read this many days on each incremental sync so late postings land.
SYNC_OVERLAP_DAYS=7
